    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int filas;

        System.out.print("Ingrese la cantidad de filas: ");
        filas = sc.nextInt();

        if (filas >= 3 && filas <= 9) {

            for (int i = 1; i <= filas; i++) {

                for (int j = 1; j <= i; j++) {
                    System.out.print(j + " ");
                }

                System.out.println();
            }

        } else {
            System.out.println("Ingrese un numero entre 3 y 9");
        }
    }
}
