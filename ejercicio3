        Scanner sc = new Scanner(System.in);

        int numero;
        int a = 0;
        int b = 1;
        int siguiente;
        int suma = 0;

        System.out.print("Ingrese la cantidad de terminos: ");
        numero = sc.nextInt();

        if (numero >= 2) {

            for (int i = 1; i <= numero; i++) {
                System.out.print(a);

                if (i < numero) {
                    System.out.print(", ");
                }

                if (a % 2 == 0) {
                    suma = suma + a;
                }

                siguiente = a + b;
                a = b;
                b = siguiente;
            }
            System.out.println("Suma de pares: " + suma);

        } else {
            System.out.println("Ingrese un numero mayor o igual a 2");
        }
    }
}
